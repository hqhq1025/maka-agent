+    #[test]
+    fn untitled_owned_dialog_is_discoverable_and_exactly_addressable() {
+        use windows::core::w;
+        use windows::Win32::Foundation::HWND;
+        use windows::Win32::UI::WindowsAndMessaging::{
+            CreateWindowExW, DestroyWindow, ShowWindow, WINDOW_EX_STYLE, WS_POPUP,
+            WS_VISIBLE, SW_HIDE,
+        };
+        struct OwnedWindow(HWND);
+        impl Drop for OwnedWindow {
+            fn drop(&mut self) { unsafe { let _ = DestroyWindow(self.0); } }
+        }
+        unsafe {
+            let owner = OwnedWindow(CreateWindowExW(WINDOW_EX_STYLE(0), w!("STATIC"),
+                w!("Cua owned-dialog regression"), WS_POPUP | WS_VISIBLE,
+                20, 20, 300, 200, None, None, None, None).unwrap());
+            let dialog = OwnedWindow(CreateWindowExW(WINDOW_EX_STYLE(0), w!("STATIC"),
+                w!(""), WS_POPUP | WS_VISIBLE,
+                30, 30, 200, 100, owner.0, None, None, None).unwrap());
+            let helper = OwnedWindow(CreateWindowExW(WINDOW_EX_STYLE(0), w!("STATIC"),
+                w!(""), WS_POPUP | WS_VISIBLE,
+                40, 40, 100, 100, None, None, None, None).unwrap());
+            let pid = std::process::id();
+            let hwnd = dialog.0.0 as u64;
+            let windows = super::list_windows_via_win32(Some(pid));
+            assert!(windows.iter().any(|window| window.hwnd == hwnd && window.title.is_empty()));
+            assert!(!windows.iter().any(|window| window.hwnd == helper.0.0 as u64));
+            assert!(super::find_window_by_pid_and_handle(pid, hwnd).is_some());
+            assert!(super::find_window_by_pid_and_handle(pid.wrapping_add(1), hwnd).is_none());
+            let _ = ShowWindow(dialog.0, SW_HIDE);
+            assert!(super::find_window_by_pid_and_handle(pid, hwnd).is_none());
+            assert!(!super::list_windows_via_win32(Some(pid)).iter().any(|window| window.hwnd == hwnd));
+        }
+    }
