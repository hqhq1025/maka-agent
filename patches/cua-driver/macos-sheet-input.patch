+/// Accept the legacy parent-window binding, or an exact sheet on the element's
+/// own parent chain. A sibling sheet and a guessed window id never match.
+///
+/// # Safety
+///
+/// `element` must remain valid for the duration of the call.
+pub unsafe fn element_is_in_window(element: AXUIElementRef, window_id: u32) -> bool {
+    element_ancestry_in_window(element, window_id) == ElementAncestry::ProvenDescendant
+}
+
+unsafe fn element_ancestry_in_window(element: AXUIElementRef, window_id: u32) -> ElementAncestry {
+    let owning_window = element_window_id(element);
+    if owning_window == Some(window_id) {
+        return ElementAncestry::ProvenDescendant;
+    }
+    let exact_sheet = has_exact_sheet_ancestor(
+        RetainedElement::retain(element as usize),
+        window_id,
+        MAX_ANCESTRY_DEPTH,
+        |element| copy_string_attr(element.as_ptr() as AXUIElementRef, "AXRole"),
+        |element| {
+            copy_element_attr(element.as_ptr() as AXUIElementRef, "AXParent").map(|parent| {
+                let retained = RetainedElement::retain(parent as usize);
+                CFRelease(parent as CFTypeRef);
+                retained
+            })
+        },
+        |element| ax_get_window_id(element.as_ptr() as AXUIElementRef),
+    );
+    if exact_sheet {
+        ElementAncestry::ProvenDescendant
+    } else if owning_window.is_some() {
+        ElementAncestry::OutsideTargetWindow
+    } else {
+        ElementAncestry::Unproven
+    }
+}
+
+fn has_exact_sheet_ancestor<E>(
+    start: E,
+    requested_window: u32,
+    max_depth: usize,
+    role: impl Fn(&E) -> Option<String>,
+    parent: impl Fn(&E) -> Option<E>,
+    window_id: impl Fn(&E) -> Option<u32>,
+) -> bool {
+    let mut current = start;
+    for _ in 0..max_depth {
+        match role(&current).as_deref() {
+            Some("AXSheet") if window_id(&current) == Some(requested_window) => return true,
+            Some("AXWindow") | Some("AXApplication") | None => return false,
+            _ => {}
+        }
+        current = match parent(&current) {
+            Some(next) => next,
+            None => return false,
+        };
+    }
+    false
 }
 
