+    #[test]
+    fn native_foreground_child_requires_the_same_exact_root() {
+        use windows::core::w;
+        use windows::Win32::Foundation::HWND;
+        use windows::Win32::UI::WindowsAndMessaging::{
+            CreateWindowExW, DestroyWindow, GetDesktopWindow, WS_CHILD, WS_EX_NOACTIVATE,
+            WS_POPUP, WS_VISIBLE,
+        };
+        struct OwnedWindow(HWND);
+        impl Drop for OwnedWindow {
+            fn drop(&mut self) {
+                unsafe { let _ = DestroyWindow(self.0); }
+            }
+        }
+        unsafe {
+            let root = OwnedWindow(CreateWindowExW(WS_EX_NOACTIVATE, w!("STATIC"),
+                w!("Foreground root regression"), WS_POPUP | WS_VISIBLE,
+                20, 20, 200, 160, None, None, None, None).unwrap());
+            let child = OwnedWindow(CreateWindowExW(WS_EX_NOACTIVATE, w!("STATIC"),
+                w!("Child"), WS_CHILD | WS_VISIBLE,
+                0, 0, 80, 40, root.0, None, None, None).unwrap());
+            let sibling = OwnedWindow(CreateWindowExW(WS_EX_NOACTIVATE, w!("STATIC"),
+                w!("Sibling"), WS_CHILD | WS_VISIBLE,
+                0, 50, 80, 40, root.0, None, None, None).unwrap());
+            let other = OwnedWindow(CreateWindowExW(WS_EX_NOACTIVATE, w!("STATIC"),
+                w!("Other root"), WS_POPUP | WS_VISIBLE,
+                240, 20, 200, 160, None, None, None, None).unwrap());
+            let other_child = OwnedWindow(CreateWindowExW(WS_EX_NOACTIVATE, w!("STATIC"),
+                w!("Other child"), WS_CHILD | WS_VISIBLE,
+                0, 0, 80, 40, other.0, None, None, None).unwrap());
+            let modal = OwnedWindow(CreateWindowExW(WS_EX_NOACTIVATE, w!("STATIC"),
+                w!("Owned modal"), WS_POPUP | WS_VISIBLE,
+                40, 40, 120, 80, root.0, None, None, None).unwrap());
+            let raw = |window: &OwnedWindow| window.0.0 as usize as u64;
+            let exact = super::foreground_matches_exact_window;
+            assert!(exact(raw(&root), raw(&root)));
+            assert!(exact(raw(&root), raw(&child)));
+            assert!(exact(raw(&child), raw(&child)));
+            assert!(!exact(raw(&child), raw(&sibling)));
+            assert!(!exact(raw(&child), raw(&root)));
+            assert!(!exact(raw(&root), raw(&other)));
+            assert!(!exact(raw(&root), raw(&other_child)));
+            assert!(!exact(raw(&root), raw(&modal)));
+            assert!(!exact(raw(&root), GetDesktopWindow().0 as usize as u64));
+            assert!(!exact(raw(&root), 0));
+            assert!(!exact(0, raw(&child)));
+
+            let bound = super::capture_foreground_target(raw(&root)).unwrap();
+            assert!(super::foreground_matches_target_or_owned_window(bound, raw(&child)));
+            assert!(super::foreground_matches_target_or_owned_window(bound, raw(&modal)));
+            assert!(!super::foreground_matches_target_or_owned_window(bound, raw(&other_child)));
+
+            let child_id = raw(&child);
+            drop(child);
+            assert!(!exact(raw(&root), child_id));
+            assert!(!super::foreground_matches_target_or_owned_window(bound, child_id));
+        }
+    }
 
