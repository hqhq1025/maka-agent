+/// Match the exact HWND, or its same-process child when the target is a root.
+/// Keep child targets exact; normalizing both HWNDs would admit sibling controls.
+pub(crate) fn foreground_matches_exact_window(target: u64, actual: u64) -> bool {
+    let Some(pid) = window_owner_pid(target) else {
+        return false;
+    };
+    if window_owner_pid(actual) != Some(pid) {
+        return false;
+    }
+    if target == actual {
+        return true;
+    }
+    let target = HWND(target as *mut _);
+    let actual = HWND(actual as *mut _);
+    unsafe { GetAncestor(target, GA_ROOT) == target && GetAncestor(actual, GA_ROOT) == target }
+}
