+/// Read at most `limit` retained elements from an AX array attribute.
+unsafe fn copy_element_array_bounded(
+    element: AXUIElementRef,
+    name: &str,
+    limit: usize,
+) -> Vec<super::snapshot::RetainedElement> {
+    if limit == 0 { return Vec::new(); }
+    let attr = CFStr::new(name);
+    let mut value: CFTypeRef = std::ptr::null();
+    if AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value) != kAXErrorSuccess
+        || value.is_null() { return Vec::new(); }
+    if core_foundation::base::CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value);
+        return Vec::new();
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+    (0..array.len()).take(limit).filter_map(|index| {
+        let item = *array.get(index)?;
+        (core_foundation::base::CFGetTypeID(item) == AXUIElementGetTypeID())
+            .then(|| super::snapshot::RetainedElement::retain(item as usize))
+    }).collect()
+}
+
+/// Find one exact same-process descendant window without walking a document unboundedly.
+/// Every queue entry owns its AX reference, including on timeout and early return.
+unsafe fn copy_ax_descendant_window(
+    app: AXUIElementRef,
+    windows: &[AXUIElementRef],
+    pid: i32,
+    window_id: u32,
+) -> Option<AXUIElementRef> {
+    use super::snapshot::RetainedElement;
+    use core_foundation::base::CFEqual;
+    use std::{collections::VecDeque, time::{Duration, Instant}};
+    const MAX_NODES: usize = 128;
+    const MAX_DEPTH: usize = 6;
+    const DEADLINE: Duration = Duration::from_millis(250);
+    let started = Instant::now();
+    let mut queue: VecDeque<_> = std::iter::once(app).chain(windows.iter().copied())
+        .take(MAX_NODES).map(|element| (RetainedElement::retain(element as usize), 0)).collect();
+    let mut seen: Vec<RetainedElement> = Vec::new();
+    while let Some((element, depth)) = queue.pop_front() {
+        if started.elapsed() >= DEADLINE || seen.len() >= MAX_NODES { break; }
+        let raw = element.as_ptr() as AXUIElementRef;
+        if seen.iter().any(|prior| CFEqual(prior.as_ptr() as CFTypeRef, raw as CFTypeRef) != 0) { continue; }
+        seen.push(element.clone());
+        let mut owner = 0;
+        if AXUIElementGetPid(raw, &mut owner) != kAXErrorSuccess || owner != pid { continue; }
+        if AXUIElementSetMessagingTimeout(raw, 0.025) != kAXErrorSuccess { continue; }
+        let role = copy_string_attr(raw, "AXRole");
+        if matches!(role.as_deref(), Some("AXWindow" | "AXSheet"))
+            && ax_get_window_id(raw) == Some(window_id)
+            && matches!(crate::windows::resolve_window_owner(pid, window_id), crate::windows::WindowOwner::SamePid) {
+            AXUIElementSetMessagingTimeout(raw, 0.0);
+            CFRetain(raw as CFTypeRef);
+            return Some(raw);
+        }
+        if depth < MAX_DEPTH {
+            for attribute in ["AXSheets", "AXChildren"] {
+                if started.elapsed() >= DEADLINE { break; }
+                let remaining = MAX_NODES.saturating_sub(seen.len() + queue.len());
+                queue.extend(copy_element_array_bounded(raw, attribute, remaining)
+                    .into_iter().map(|child| (child, depth + 1)));
+            }
+        }
+        AXUIElementSetMessagingTimeout(raw, 0.0);
+    }
+    None
 }
 
